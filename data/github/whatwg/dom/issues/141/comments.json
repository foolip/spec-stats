    "created_at": "2016-01-06T02:47:30Z",
    "updated_at": "2016-01-06T02:47:30Z",
    "body": "No, that seems bogus.  Looks like getOwnPropertyNames should only return lowercased versions of names, right?\n",
    "author_association": "NONE",
    "pin": null,
