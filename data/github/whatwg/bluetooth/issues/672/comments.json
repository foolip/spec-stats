  {
    "url": "https://api.github.com/repos/whatwg/bluetooth/issues/comments/5259460210",
    "html_url": "https://github.com/whatwg/bluetooth/pull/672#issuecomment-5259460210",
    "issue_url": "https://api.github.com/repos/whatwg/bluetooth/issues/672",
    "id": 5259460210,
    "node_id": "IC_kwDOAVr2cs8AAAABOXz-cg",
    "user": {
      "login": "dlech",
      "id": 963645,
      "node_id": "MDQ6VXNlcjk2MzY0NQ==",
      "avatar_url": "https://avatars.githubusercontent.com/u/963645?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/dlech",
      "html_url": "https://github.com/dlech",
      "followers_url": "https://api.github.com/users/dlech/followers",
      "following_url": "https://api.github.com/users/dlech/following{/other_user}",
      "gists_url": "https://api.github.com/users/dlech/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/dlech/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/dlech/subscriptions",
      "organizations_url": "https://api.github.com/users/dlech/orgs",
      "repos_url": "https://api.github.com/users/dlech/repos",
      "events_url": "https://api.github.com/users/dlech/events{/privacy}",
      "received_events_url": "https://api.github.com/users/dlech/received_events",
      "type": "User",
      "user_view_type": "public",
      "site_admin": false
