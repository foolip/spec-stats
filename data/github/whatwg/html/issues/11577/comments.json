      "login": "lukewarlow",
      "id": 32498324,
      "node_id": "MDQ6VXNlcjMyNDk4MzI0",
      "avatar_url": "https://avatars.githubusercontent.com/u/32498324?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/lukewarlow",
      "html_url": "https://github.com/lukewarlow",
      "followers_url": "https://api.github.com/users/lukewarlow/followers",
