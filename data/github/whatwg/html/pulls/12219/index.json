    "followers_url": "https://api.github.com/users/hjanuschka/followers",
    "following_url": "https://api.github.com/users/hjanuschka/following{/other_user}",
    "gists_url": "https://api.github.com/users/hjanuschka/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/hjanuschka/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/hjanuschka/subscriptions",
    "organizations_url": "https://api.github.com/users/hjanuschka/orgs",
    "repos_url": "https://api.github.com/users/hjanuschka/repos",
    "events_url": "https://api.github.com/users/hjanuschka/events{/privacy}",
    "received_events_url": "https://api.github.com/users/hjanuschka/received_events",
