      "subscriptions_url": "https://api.github.com/users/cdumez/subscriptions",
      "organizations_url": "https://api.github.com/users/cdumez/orgs",
      "repos_url": "https://api.github.com/users/cdumez/repos",
      "events_url": "https://api.github.com/users/cdumez/events{/privacy}",
      "received_events_url": "https://api.github.com/users/cdumez/received_events",
      "type": "User",
