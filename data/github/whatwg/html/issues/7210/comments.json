      "subscriptions_url": "https://api.github.com/users/junov/subscriptions",
      "organizations_url": "https://api.github.com/users/junov/orgs",
      "repos_url": "https://api.github.com/users/junov/repos",
      "events_url": "https://api.github.com/users/junov/events{/privacy}",
      "received_events_url": "https://api.github.com/users/junov/received_events",
      "type": "User",
