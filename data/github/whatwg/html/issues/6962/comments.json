  {
    "url": "https://api.github.com/repos/whatwg/html/issues/comments/920753823",
    "html_url": "https://github.com/whatwg/html/issues/6962#issuecomment-920753823",
    "issue_url": "https://api.github.com/repos/whatwg/html/issues/6962",
    "id": 920753823,
    "node_id": "IC_kwDOALaj48424Zaf",
    "user": {
      "login": "hsivonen",
      "id": 478856,
      "node_id": "MDQ6VXNlcjQ3ODg1Ng==",
      "avatar_url": "https://avatars.githubusercontent.com/u/478856?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/hsivonen",
      "html_url": "https://github.com/hsivonen",
      "followers_url": "https://api.github.com/users/hsivonen/followers",
