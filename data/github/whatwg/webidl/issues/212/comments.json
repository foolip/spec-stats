  {
    "url": "https://api.github.com/repos/whatwg/webidl/issues/comments/505215677",
    "html_url": "https://github.com/whatwg/webidl/issues/212#issuecomment-505215677",
    "issue_url": "https://api.github.com/repos/whatwg/webidl/issues/212",
    "id": 505215677,
    "node_id": "MDEyOklzc3VlQ29tbWVudDUwNTIxNTY3Nw==",
    "user": {
      "login": "bzbarsky",
