  {
    "url": "https://api.github.com/repos/whatwg/webidl/issues/comments/685974403",
    "html_url": "https://github.com/whatwg/webidl/issues/656#issuecomment-685974403",
    "issue_url": "https://api.github.com/repos/whatwg/webidl/issues/656",
    "id": 685974403,
    "node_id": "MDEyOklzc3VlQ29tbWVudDY4NTk3NDQwMw==",
