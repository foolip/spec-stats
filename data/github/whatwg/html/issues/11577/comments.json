      "gists_url": "https://api.github.com/users/lukewarlow/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/lukewarlow/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/lukewarlow/subscriptions",
      "organizations_url": "https://api.github.com/users/lukewarlow/orgs",
