  {
    "url": "https://api.github.com/repos/whatwg/bluetooth/issues/comments/649127698",
    "html_url": "https://github.com/whatwg/bluetooth/issues/499#issuecomment-649127698",
    "issue_url": "https://api.github.com/repos/whatwg/bluetooth/issues/499",
    "id": 649127698,
