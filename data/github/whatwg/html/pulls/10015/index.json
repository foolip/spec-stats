  "title": "Hide all popovers when beforetoggle shows a popover",
  "user": {
    "login": "josepharhar",
    "id": 7681467,
    "node_id": "MDQ6VXNlcjc2ODE0Njc=",
    "avatar_url": "https://avatars.githubusercontent.com/u/7681467?v=4",
