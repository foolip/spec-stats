    "created_at": "2018-07-20T16:22:33Z",
    "updated_at": "2018-07-20T16:22:33Z",
    "body": "Yeah, I don't think we should do this. Check for `null` with `getAttribute()` or use `hasAttribute()`. If your code relies on empty string meaning not present it's already somewhat broken.",
    "author_association": "MEMBER",
    "pin": null,
