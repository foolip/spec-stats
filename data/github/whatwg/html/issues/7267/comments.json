      "organizations_url": "https://api.github.com/users/wanderview/orgs",
      "repos_url": "https://api.github.com/users/wanderview/repos",
      "events_url": "https://api.github.com/users/wanderview/events{/privacy}",
      "received_events_url": "https://api.github.com/users/wanderview/received_events",
      "type": "User",
