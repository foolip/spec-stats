      "subscriptions_url": "https://api.github.com/users/mgaudet/subscriptions",
      "organizations_url": "https://api.github.com/users/mgaudet/orgs",
      "repos_url": "https://api.github.com/users/mgaudet/repos",
      "events_url": "https://api.github.com/users/mgaudet/events{/privacy}",
      "received_events_url": "https://api.github.com/users/mgaudet/received_events",
      "type": "User",
