  "title": "Don't scroll in focus() when the focus doesn't move",
  "user": {
    "login": "mrego",
    "id": 11602,
    "node_id": "MDQ6VXNlcjExNjAy",
    "avatar_url": "https://avatars.githubusercontent.com/u/11602?v=4",
