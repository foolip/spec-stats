  "title": "Let user agent features read responses to their no-cors requests",
  "user": {
    "login": "zcorpan",
    "id": 244772,
    "node_id": "MDQ6VXNlcjI0NDc3Mg==",
    "avatar_url": "https://avatars.githubusercontent.com/u/244772?v=4",
    "gravatar_id": "",
