  "title": "Correct transient registered observer bookkeeping and callback order",
  "user": {
    "login": "annevk",
    "id": 1544111,
    "node_id": "MDQ6VXNlcjE1NDQxMTE=",
    "avatar_url": "https://avatars.githubusercontent.com/u/1544111?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/annevk",
    "html_url": "https://github.com/annevk",
