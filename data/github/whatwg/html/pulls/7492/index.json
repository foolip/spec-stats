  "title": "Editorial: fix example for header rowgroup scope",
  "user": {
    "login": "vassudanagunta",
    "id": 2830093,
    "node_id": "MDQ6VXNlcjI4MzAwOTM=",
    "avatar_url": "https://avatars.githubusercontent.com/u/2830093?v=4",
    "gravatar_id": "",
