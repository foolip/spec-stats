  "title": "Use \"inherit left, wildcard right\" behavior in base URL application and constructor string parsing.",
  "user": {
    "login": "jeremyroman",
    "id": 156119,
    "node_id": "MDQ6VXNlcjE1NjExOQ==",
    "avatar_url": "https://avatars.githubusercontent.com/u/156119?v=4",
    "gravatar_id": "",
