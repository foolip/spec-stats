  "title": "Makes Canvas' ConicGradient match CSS angle",
  "user": {
    "login": "fserb",
    "id": 1587,
    "node_id": "MDQ6VXNlcjE1ODc=",
    "avatar_url": "https://avatars.githubusercontent.com/u/1587?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/fserb",
    "html_url": "https://github.com/fserb",
    "followers_url": "https://api.github.com/users/fserb/followers",
