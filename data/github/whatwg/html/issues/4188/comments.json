    "created_at": "2018-11-21T20:32:42Z",
    "updated_at": "2018-11-21T20:33:10Z",
    "body": "Gecko's stable state handling is based on the pre-stable-state-during-microtask model which HTML spec used to have, which used to be basically end-of-task model.",
    "author_association": "NONE",
    "pin": null,
    "reactions": {
