  "title": "Add a fully active check for EventTarget in event listener inner invoke",
  "user": {
    "login": "shaseley",
    "id": 2731352,
    "node_id": "MDQ6VXNlcjI3MzEzNTI=",
    "avatar_url": "https://avatars.githubusercontent.com/u/2731352?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/shaseley",
    "html_url": "https://github.com/shaseley",
