      "id": 6257356,
      "node_id": "MDQ6VXNlcjYyNTczNTY=",
      "avatar_url": "https://avatars.githubusercontent.com/u/6257356?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/bathos",
      "html_url": "https://github.com/bathos",
      "followers_url": "https://api.github.com/users/bathos/followers",
      "following_url": "https://api.github.com/users/bathos/following{/other_user}",
      "gists_url": "https://api.github.com/users/bathos/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/bathos/starred{/owner}{/repo}",
