      "starred_url": "https://api.github.com/users/shannonbooth/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/shannonbooth/subscriptions",
      "organizations_url": "https://api.github.com/users/shannonbooth/orgs",
      "repos_url": "https://api.github.com/users/shannonbooth/repos",
      "events_url": "https://api.github.com/users/shannonbooth/events{/privacy}",
