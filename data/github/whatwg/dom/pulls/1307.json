  "title": "Introduce `moveBefore()` state-preserving atomic move API",
  "user": {
    "login": "domfarolino",
    "id": 9669289,
    "node_id": "MDQ6VXNlcjk2NjkyODk=",
    "avatar_url": "https://avatars.githubusercontent.com/u/9669289?v=4",
