    "created_at": "2018-08-30T07:58:53Z",
    "updated_at": "2018-08-30T07:58:53Z",
    "body": "The behavior and semantic aspects typically use the DOM tree rather than how it's rendered. I think accesskey on legend should work the same even if you style it with e.g. float: left.",
    "author_association": "MEMBER",
    "pin": null,
