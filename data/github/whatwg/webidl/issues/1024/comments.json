  {
    "url": "https://api.github.com/repos/whatwg/webidl/issues/comments/925151901",
    "html_url": "https://github.com/whatwg/webidl/issues/1024#issuecomment-925151901",
    "issue_url": "https://api.github.com/repos/whatwg/webidl/issues/1024",
