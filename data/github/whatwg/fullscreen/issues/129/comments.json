      "starred_url": "https://api.github.com/users/jernoble/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/jernoble/subscriptions",
      "organizations_url": "https://api.github.com/users/jernoble/orgs",
      "repos_url": "https://api.github.com/users/jernoble/repos",
      "events_url": "https://api.github.com/users/jernoble/events{/privacy}",
      "received_events_url": "https://api.github.com/users/jernoble/received_events",
      "type": "User",
      "user_view_type": "public",
      "site_admin": false
