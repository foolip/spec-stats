  "title": "Do not run \"Update a style block\" while style element is on stack of open elements\r",
  "user": {
    "login": "TimvdLippe",
    "id": 5948271,
    "node_id": "MDQ6VXNlcjU5NDgyNzE=",
    "avatar_url": "https://avatars.githubusercontent.com/u/5948271?v=4",
