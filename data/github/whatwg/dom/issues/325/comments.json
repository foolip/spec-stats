      "url": "https://api.github.com/users/dtapuska",
      "html_url": "https://github.com/dtapuska",
      "followers_url": "https://api.github.com/users/dtapuska/followers",
      "following_url": "https://api.github.com/users/dtapuska/following{/other_user}",
      "gists_url": "https://api.github.com/users/dtapuska/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/dtapuska/starred{/owner}{/repo}",
