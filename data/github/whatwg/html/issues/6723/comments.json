      "starred_url": "https://api.github.com/users/jeremyroman/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/jeremyroman/subscriptions",
      "organizations_url": "https://api.github.com/users/jeremyroman/orgs",
      "repos_url": "https://api.github.com/users/jeremyroman/repos",
      "events_url": "https://api.github.com/users/jeremyroman/events{/privacy}",
