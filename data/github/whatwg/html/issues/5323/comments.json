      "url": "https://api.github.com/users/elkurin",
      "html_url": "https://github.com/elkurin",
      "followers_url": "https://api.github.com/users/elkurin/followers",
      "following_url": "https://api.github.com/users/elkurin/following{/other_user}",
      "gists_url": "https://api.github.com/users/elkurin/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/elkurin/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/elkurin/subscriptions",
      "organizations_url": "https://api.github.com/users/elkurin/orgs",
      "repos_url": "https://api.github.com/users/elkurin/repos",
      "events_url": "https://api.github.com/users/elkurin/events{/privacy}",
