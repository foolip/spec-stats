      "url": "https://api.github.com/users/takenspc",
      "html_url": "https://github.com/takenspc",
      "followers_url": "https://api.github.com/users/takenspc/followers",
      "following_url": "https://api.github.com/users/takenspc/following{/other_user}",
      "gists_url": "https://api.github.com/users/takenspc/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/takenspc/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/takenspc/subscriptions",
      "organizations_url": "https://api.github.com/users/takenspc/orgs",
      "repos_url": "https://api.github.com/users/takenspc/repos",
      "events_url": "https://api.github.com/users/takenspc/events{/privacy}",
      "received_events_url": "https://api.github.com/users/takenspc/received_events",
      "type": "User",
