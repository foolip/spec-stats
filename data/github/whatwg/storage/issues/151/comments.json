      "gists_url": "https://api.github.com/users/LJWatson/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/LJWatson/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/LJWatson/subscriptions",
      "organizations_url": "https://api.github.com/users/LJWatson/orgs",
      "repos_url": "https://api.github.com/users/LJWatson/repos",
      "events_url": "https://api.github.com/users/LJWatson/events{/privacy}",
