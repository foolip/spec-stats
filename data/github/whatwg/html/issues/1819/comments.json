    "created_at": "2016-09-26T12:30:53Z",
    "updated_at": "2016-09-26T12:30:53Z",
    "body": "What would be observable if we return the `SharedWorker` object earlier and run the remaining steps in parallel before invoking run a worker?\n",
    "author_association": "MEMBER",
    "pin": null,
