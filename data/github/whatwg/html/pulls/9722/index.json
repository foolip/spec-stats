  "title": "Throw TypeError if `window.opener` setter fails to reconfigure the property",
  "user": {
    "login": "shvaikalesh",
    "id": 5098878,
    "node_id": "MDQ6VXNlcjUwOTg4Nzg=",
    "avatar_url": "https://avatars.githubusercontent.com/u/5098878?v=4",
