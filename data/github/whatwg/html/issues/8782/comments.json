  {
    "url": "https://api.github.com/repos/whatwg/html/issues/comments/1591586904",
    "html_url": "https://github.com/whatwg/html/issues/8782#issuecomment-1591586904",
    "issue_url": "https://api.github.com/repos/whatwg/html/issues/8782",
    "id": 1591586904,
    "node_id": "IC_kwDOALaj485e3bBY",
    "user": {
      "login": "khushalsagar",
      "id": 63884798,
      "node_id": "MDQ6VXNlcjYzODg0Nzk4",
      "avatar_url": "https://avatars.githubusercontent.com/u/63884798?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/khushalsagar",
      "html_url": "https://github.com/khushalsagar",
      "followers_url": "https://api.github.com/users/khushalsagar/followers",
      "following_url": "https://api.github.com/users/khushalsagar/following{/other_user}",
