      "following_url": "https://api.github.com/users/jfkthame/following{/other_user}",
      "gists_url": "https://api.github.com/users/jfkthame/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/jfkthame/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/jfkthame/subscriptions",
      "organizations_url": "https://api.github.com/users/jfkthame/orgs",
      "repos_url": "https://api.github.com/users/jfkthame/repos",
      "events_url": "https://api.github.com/users/jfkthame/events{/privacy}",
      "received_events_url": "https://api.github.com/users/jfkthame/received_events",
      "type": "User",
