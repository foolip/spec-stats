    "created_at": "2015-09-05T14:12:51Z",
    "updated_at": "2015-09-05T14:12:51Z",
    "body": "Mode is used by the request so that does not help you. What you want given the current language in the HTML Standard is to treat such responses as if they were \"CORS-cross-origin\".\n",
    "author_association": "MEMBER",
    "pin": null,
