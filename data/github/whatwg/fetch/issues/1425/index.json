  "body": "if i use json() text()\r\nhavesize  !=headers['content-length'];\r\n\r\n```javascrpt\r\n let response = await fetch(request),havesize=0;\r\nfor (const [key, value] of response.headers.entries()) {\r\n        headers[key] = value;\r\n\r\n    }\r\n    const reader = response.body.getReader();\r\n    const stream = new ReadableStream({\r\n        start(controller) {\r\n            let push = e => {\r\n                reader.read().then(({done,value}) => {\r\n                    if (done) {\r\n                        controller.close();\r\n                        push = null;\r\n                        return;\r\n                    }\r\n                    havesize += value.length;\r\n                    let statussize = '0%';\r\n                    if(headers['content-length'])statussize = Math.floor(havesize / Number(headers['content-cength']) * 100) + '%';  \r\n                    controller.enqueue(value);\r\n                    push();\r\n                });\r\n            }\r\n            push();\r\n        }\r\n    });\r\n\r\n```",
