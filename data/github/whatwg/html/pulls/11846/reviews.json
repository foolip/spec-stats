      "gists_url": "https://api.github.com/users/annevk/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/annevk/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/annevk/subscriptions",
