      "gists_url": "https://api.github.com/users/alvestrand/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/alvestrand/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/alvestrand/subscriptions",
      "organizations_url": "https://api.github.com/users/alvestrand/orgs",
      "repos_url": "https://api.github.com/users/alvestrand/repos",
      "events_url": "https://api.github.com/users/alvestrand/events{/privacy}",
      "received_events_url": "https://api.github.com/users/alvestrand/received_events",
      "type": "User",
