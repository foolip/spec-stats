      "subscriptions_url": "https://api.github.com/users/jakearchibald/subscriptions",
      "organizations_url": "https://api.github.com/users/jakearchibald/orgs",
      "repos_url": "https://api.github.com/users/jakearchibald/repos",
      "events_url": "https://api.github.com/users/jakearchibald/events{/privacy}",
      "received_events_url": "https://api.github.com/users/jakearchibald/received_events",
      "type": "User",
