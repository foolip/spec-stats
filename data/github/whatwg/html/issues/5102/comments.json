      "following_url": "https://api.github.com/users/mikewest/following{/other_user}",
      "gists_url": "https://api.github.com/users/mikewest/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/mikewest/starred{/owner}{/repo}",
