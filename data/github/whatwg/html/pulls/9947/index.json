  "title": "Editorial: make enumerated attributes missing/invalid wording consistent",
  "user": {
    "login": "keithamus",
    "id": 118266,
    "node_id": "MDQ6VXNlcjExODI2Ng==",
    "avatar_url": "https://avatars.githubusercontent.com/u/118266?v=4",
