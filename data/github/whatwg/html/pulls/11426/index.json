1426/66b4fb9...6385a2b/semantics.html\" title=\"Last updated on Sep 10, 2025, 1:27 AM UTC (6385a2b)\">diff</a> )\n<a href=\"https://whatpr.org/html/11426/urls-and-fetching.html\" title=\"Last updated on Sep 10, 2025, 1:27 AM UTC (6385a2b)\">/urls-and-fetching.html</a>  ( <a href=\"https://whatpr.org/html/11426/66b4fb9...6385a2b/urls-and-fetching.html\" title=\"Last updated on Sep 10, 2025, 1:27 AM UTC (6385a2b)\">diff</a> )\n<a href=\"https://whatpr.org/html/11426/webappapis.html\" title=\"Last updated on Sep 10, 2025, 1:27 AM UTC (6385a2b)\">/webappapis.html</a>  ( <a href=\"https://whatpr.org/html/11426/66b4fb9...6385a2b/webappapis.html\" title=\"Last updated on Sep 10, 2025, 1:27 AM UTC (6385a2b)\">diff</a> )\n<a href=\"https://whatpr.org/html/11426/speculative-loading.html\" title=\"Last updated on Sep 10, 2025, 1:27 AM UTC (6385a2b)\">/speculative-loading.html</a>  ( <a href=\"https://whatpr.org/html/11426/66b4fb9...6385a2b/speculative-loading.html\" title=\"Last updated on Sep 10, 2025, 1:27 AM UTC (6385a2b)\">diff</a> )",
