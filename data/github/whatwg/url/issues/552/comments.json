      "avatar_url": "https://avatars.githubusercontent.com/u/19497908?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/rmisev",
      "html_url": "https://github.com/rmisev",
      "followers_url": "https://api.github.com/users/rmisev/followers",
      "following_url": "https://api.github.com/users/rmisev/following{/other_user}",
