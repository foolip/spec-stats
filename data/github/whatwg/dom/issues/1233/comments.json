    "html_url": "https://github.com/whatwg/dom/issues/1233#issuecomment-1831191658",
    "issue_url": "https://api.github.com/repos/whatwg/dom/issues/1233",
    "id": 1831191658,
    "node_id": "IC_kwDOAFUqXs5tJcRq",
    "user": {
      "login": "AdamSobieski",
      "id": 1072800,
      "node_id": "MDQ6VXNlcjEwNzI4MDA=",
      "avatar_url": "https://avatars.githubusercontent.com/u/1072800?v=4",
