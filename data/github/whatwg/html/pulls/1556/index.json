  "locked": false,
  "title": "Remove the \"replace\" argument to window.open()",
  "user": {
    "login": "domenic",
    "id": 617481,
    "node_id": "MDQ6VXNlcjYxNzQ4MQ==",
    "avatar_url": "https://avatars.githubusercontent.com/u/617481?v=4",
