    "issue_url": "https://api.github.com/repos/whatwg/html/issues/7189",
    "id": 2107318879,
    "node_id": "IC_kwDOALaj4859myJf",
    "user": {
      "login": "Maxim-Mazurok",
      "id": 7756211,
      "node_id": "MDQ6VXNlcjc3NTYyMTE=",
      "avatar_url": "https://avatars.githubusercontent.com/u/7756211?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/Maxim-Mazurok",
      "html_url": "https://github.com/Maxim-Mazurok",
      "followers_url": "https://api.github.com/users/Maxim-Mazurok/followers",
