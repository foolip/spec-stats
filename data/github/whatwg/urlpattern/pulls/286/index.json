  "title": "Fix unexpected stripping of default port in port canonicalization",
  "user": {
    "login": "sisidovski",
    "id": 1642255,
    "node_id": "MDQ6VXNlcjE2NDIyNTU=",
    "avatar_url": "https://avatars.githubusercontent.com/u/1642255?v=4",
