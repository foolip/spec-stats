  {
    "url": "https://api.github.com/repos/whatwg/fullscreen/issues/comments/313371863",
    "html_url": "https://github.com/whatwg/fullscreen/issues/93#issuecomment-313371863",
    "issue_url": "https://api.github.com/repos/whatwg/fullscreen/issues/93",
    "id": 313371863,
    "node_id": "MDEyOklzc3VlQ29tbWVudDMxMzM3MTg2Mw==",
    "user": {
      "login": "foolip",
      "id": 498917,
      "node_id": "MDQ6VXNlcjQ5ODkxNw==",
      "avatar_url": "https://avatars.githubusercontent.com/u/498917?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/foolip",
      "html_url": "https://github.com/foolip",
      "followers_url": "https://api.github.com/users/foolip/followers",
