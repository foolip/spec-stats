      "subscriptions_url": "https://api.github.com/users/yoshisatoyanagisawa/subscriptions",
      "organizations_url": "https://api.github.com/users/yoshisatoyanagisawa/orgs",
      "repos_url": "https://api.github.com/users/yoshisatoyanagisawa/repos",
      "events_url": "https://api.github.com/users/yoshisatoyanagisawa/events{/privacy}",
      "received_events_url": "https://api.github.com/users/yoshisatoyanagisawa/received_events",
      "type": "User",
