  "body": "@Benvie prompted me to write this and now I'm feeling depressed.\n\n``` js\nfunction makeLoggerStream(otherStream) {\n  return new ReadableStream({\n    pull(push, close, error) {\n      if (otherStream.state !== \"readable\") {\n        otherStream.wait().then(... // basically extract all the below into a helper function\n      }\n\n      while (otherStream.state === \"readable\") {\n        push(otherStream.read());\n      }\n\n      if (otherStream.state === \"closed\") {\n        close();\n      }\n\n      if (otherStream.state === \"errored\") {\n        try {\n            otherStream.read();\n        } catch (e) {\n            error(e);\n        }\n      }\n    }\n\n    cancel(reason) {\n      otherStream.cancel(reason);\n    }\n  });\n}\n```\n",
