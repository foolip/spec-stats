      "starred_url": "https://api.github.com/users/r12a/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/r12a/subscriptions",
      "organizations_url": "https://api.github.com/users/r12a/orgs",
      "repos_url": "https://api.github.com/users/r12a/repos",
      "events_url": "https://api.github.com/users/r12a/events{/privacy}",
