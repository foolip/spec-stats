  "locked": false,
  "title": "Do not dispatch a trusted event when target and reletedTarget are identical",
  "user": {
    "login": "hayatoito",
    "id": 160288,
    "node_id": "MDQ6VXNlcjE2MDI4OA==",
    "avatar_url": "https://avatars.githubusercontent.com/u/160288?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/hayatoito",
    "html_url": "https://github.com/hayatoito",
    "followers_url": "https://api.github.com/users/hayatoito/followers",
    "following_url": "https://api.github.com/users/hayatoito/following{/other_user}",
    "gists_url": "https://api.github.com/users/hayatoito/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/hayatoito/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/hayatoito/subscriptions",
    "organizations_url": "https://api.github.com/users/hayatoito/orgs",
    "repos_url": "https://api.github.com/users/hayatoito/repos",
    "events_url": "https://api.github.com/users/hayatoito/events{/privacy}",
