    "body": "While doing the changes in the fetch spec, I noticed that this would also allow `<link rel=\"preload\" as=\"json\" href=\"...\">`.",
    "author_association": "MEMBER",
    "reactions": {
      "url": "https://api.github.com/repos/whatwg/html/issues/comments/1649836538/reactions",
