  {
    "url": "https://api.github.com/repos/whatwg/html/issues/comments/393155404",
    "html_url": "https://github.com/whatwg/html/pull/3721#issuecomment-393155404",
    "issue_url": "https://api.github.com/repos/whatwg/html/issues/3721",
    "id": 393155404,
    "node_id": "MDEyOklzc3VlQ29tbWVudDM5MzE1NTQwNA==",
    "user": {
      "login": "bzbarsky",
      "id": 1457979,
