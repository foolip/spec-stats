    "created_at": "2017-04-25T22:28:40Z",
    "updated_at": "2017-04-25T22:32:09Z",
    "body": "When fixing this, please also consider what happens if you use `pushState`, followed by `window.location.hash = 'foo'`.\r\n\r\nIn Firefox this will update the `:target`, but in Webkit browsers the visible hash changes, but the `:target` is not affected until there is any kind of non-pushed change to the url.",
    "author_association": "NONE",
    "pin": null,
