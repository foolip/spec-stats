    "issue_url": "https://api.github.com/repos/whatwg/fullscreen/issues/129",
    "id": 398794247,
    "node_id": "MDEyOklzc3VlQ29tbWVudDM5ODc5NDI0Nw==",
    "user": {
      "login": "jernoble",
      "id": 1557428,
      "node_id": "MDQ6VXNlcjE1NTc0Mjg=",
      "avatar_url": "https://avatars.githubusercontent.com/u/1557428?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/jernoble",
      "html_url": "https://github.com/jernoble",
      "followers_url": "https://api.github.com/users/jernoble/followers",
      "following_url": "https://api.github.com/users/jernoble/following{/other_user}",
