  {
    "url": "https://api.github.com/repos/whatwg/html/issues/comments/922819513",
    "html_url": "https://github.com/whatwg/html/issues/2614#issuecomment-922819513",
    "issue_url": "https://api.github.com/repos/whatwg/html/issues/2614",
    "id": 922819513,
    "node_id": "IC_kwDOALaj4843ARu5",
    "user": {
      "login": "annevk",
      "id": 1544111,
      "node_id": "MDQ6VXNlcjE1NDQxMTE=",
      "avatar_url": "https://avatars.githubusercontent.com/u/1544111?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/annevk",
      "html_url": "https://github.com/annevk",
      "followers_url": "https://api.github.com/users/annevk/followers",
