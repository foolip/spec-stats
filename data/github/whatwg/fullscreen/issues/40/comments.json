    "created_at": "2016-06-17T09:50:01Z",
    "updated_at": "2016-06-17T09:50:01Z",
    "body": "Note that fullscreen root doesn't have a visible `::backdrop` pseudo-element, so it doesn't matter whether the background is propagated.\n",
    "author_association": "MEMBER",
    "pin": null,
