    "following_url": "https://api.github.com/users/TimvdLippe/following{/other_user}",
    "gists_url": "https://api.github.com/users/TimvdLippe/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/TimvdLippe/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/TimvdLippe/subscriptions",
    "organizations_url": "https://api.github.com/users/TimvdLippe/orgs",
    "repos_url": "https://api.github.com/users/TimvdLippe/repos",
    "events_url": "https://api.github.com/users/TimvdLippe/events{/privacy}",
