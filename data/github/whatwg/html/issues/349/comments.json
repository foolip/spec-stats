      "node_id": "MDQ6VXNlcjk0NDYzOQ==",
      "avatar_url": "https://avatars.githubusercontent.com/u/944639?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/majido",
      "html_url": "https://github.com/majido",
      "followers_url": "https://api.github.com/users/majido/followers",
      "following_url": "https://api.github.com/users/majido/following{/other_user}",
      "gists_url": "https://api.github.com/users/majido/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/majido/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/majido/subscriptions",
      "organizations_url": "https://api.github.com/users/majido/orgs",
      "repos_url": "https://api.github.com/users/majido/repos",
      "events_url": "https://api.github.com/users/majido/events{/privacy}",
      "received_events_url": "https://api.github.com/users/majido/received_events",
      "type": "User",
