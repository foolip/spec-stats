  "title": "Treat trusted `contextmenu` events as user activation.",
  "user": {
    "login": "mustaqahmed",
    "id": 8505377,
    "node_id": "MDQ6VXNlcjg1MDUzNzc=",
    "avatar_url": "https://avatars.githubusercontent.com/u/8505377?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/mustaqahmed",
    "html_url": "https://github.com/mustaqahmed",
    "followers_url": "https://api.github.com/users/mustaqahmed/followers",
    "following_url": "https://api.github.com/users/mustaqahmed/following{/other_user}",
    "gists_url": "https://api.github.com/users/mustaqahmed/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/mustaqahmed/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/mustaqahmed/subscriptions",
    "organizations_url": "https://api.github.com/users/mustaqahmed/orgs",
