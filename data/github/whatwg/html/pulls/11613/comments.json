      "avatar_url": "https://avatars.githubusercontent.com/u/366761?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/flackr",
      "html_url": "https://github.com/flackr",
      "followers_url": "https://api.github.com/users/flackr/followers",
