    "following_url": "https://api.github.com/users/zcorpan/following{/other_user}",
    "gists_url": "https://api.github.com/users/zcorpan/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/zcorpan/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/zcorpan/subscriptions",
    "organizations_url": "https://api.github.com/users/zcorpan/orgs",
    "repos_url": "https://api.github.com/users/zcorpan/repos",
