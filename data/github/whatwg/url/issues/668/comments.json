  {
    "url": "https://api.github.com/repos/whatwg/url/issues/comments/1457739221",
    "html_url": "https://github.com/whatwg/url/issues/668#issuecomment-1457739221",
    "issue_url": "https://api.github.com/repos/whatwg/url/issues/668",
    "id": 1457739221,
    "node_id": "IC_kwDOAFmX0c5W41XV",
    "user": {
      "login": "karwa",
      "id": 5254025,
      "node_id": "MDQ6VXNlcjUyNTQwMjU=",
      "avatar_url": "https://avatars.githubusercontent.com/u/5254025?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/karwa",
      "html_url": "https://github.com/karwa",
      "followers_url": "https://api.github.com/users/karwa/followers",
      "following_url": "https://api.github.com/users/karwa/following{/other_user}",
      "gists_url": "https://api.github.com/users/karwa/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/karwa/starred{/owner}{/repo}",
