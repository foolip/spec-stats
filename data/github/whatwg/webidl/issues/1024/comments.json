      "starred_url": "https://api.github.com/users/aphillips/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/aphillips/subscriptions",
      "organizations_url": "https://api.github.com/users/aphillips/orgs",
      "repos_url": "https://api.github.com/users/aphillips/repos",
      "events_url": "https://api.github.com/users/aphillips/events{/privacy}",
      "received_events_url": "https://api.github.com/users/aphillips/received_events",
      "type": "User",
