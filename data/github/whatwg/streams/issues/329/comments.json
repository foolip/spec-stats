      "following_url": "https://api.github.com/users/tyoshino/following{/other_user}",
      "gists_url": "https://api.github.com/users/tyoshino/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/tyoshino/starred{/owner}{/repo}",
