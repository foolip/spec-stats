  "title": "Fix hiding popovers that are removed or moved between documents",
  "user": {
    "login": "jakearchibald",
    "id": 93594,
    "node_id": "MDQ6VXNlcjkzNTk0",
    "avatar_url": "https://avatars.githubusercontent.com/u/93594?v=4",
