  "locked": false,
  "title": "Use consistent name for character encoding concept",
  "user": {
    "login": "sprrw",
    "id": 16442088,
    "node_id": "MDQ6VXNlcjE2NDQyMDg4",
    "avatar_url": "https://avatars.githubusercontent.com/u/16442088?v=4",
    "gravatar_id": "",
