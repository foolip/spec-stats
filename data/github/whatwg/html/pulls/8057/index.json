  "locked": false,
  "title": "Make about:srcdoc to inherit PolicyContainer from history.",
  "user": {
    "login": "ArthurSonzogni",
    "id": 4759106,
    "node_id": "MDQ6VXNlcjQ3NTkxMDY=",
    "avatar_url": "https://avatars.githubusercontent.com/u/4759106?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/ArthurSonzogni",
    "html_url": "https://github.com/ArthurSonzogni",
    "followers_url": "https://api.github.com/users/ArthurSonzogni/followers",
    "following_url": "https://api.github.com/users/ArthurSonzogni/following{/other_user}",
    "gists_url": "https://api.github.com/users/ArthurSonzogni/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/ArthurSonzogni/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/ArthurSonzogni/subscriptions",
    "organizations_url": "https://api.github.com/users/ArthurSonzogni/orgs",
    "repos_url": "https://api.github.com/users/ArthurSonzogni/repos",
    "events_url": "https://api.github.com/users/ArthurSonzogni/events{/privacy}",
    "received_events_url": "https://api.github.com/users/ArthurSonzogni/received_events",
    "type": "User",
