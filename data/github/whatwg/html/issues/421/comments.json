  {
    "url": "https://api.github.com/repos/whatwg/html/issues/comments/1260360824",
    "html_url": "https://github.com/whatwg/html/issues/421#issuecomment-1260360824",
    "issue_url": "https://api.github.com/repos/whatwg/html/issues/421",
    "id": 1260360824,
    "node_id": "IC_kwDOALaj485LH5R4",
    "user": {
      "login": "domenic",
      "id": 617481,
      "node_id": "MDQ6VXNlcjYxNzQ4MQ==",
      "avatar_url": "https://avatars.githubusercontent.com/u/617481?v=4",
