    "issue_url": "https://api.github.com/repos/whatwg/html/issues/3704",
    "id": 519557107,
    "node_id": "MDEyOklzc3VlQ29tbWVudDUxOTU1NzEwNw==",
    "user": {
      "login": "a3nm",
      "id": 843551,
      "node_id": "MDQ6VXNlcjg0MzU1MQ==",
      "avatar_url": "https://avatars.githubusercontent.com/u/843551?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/a3nm",
      "html_url": "https://github.com/a3nm",
      "followers_url": "https://api.github.com/users/a3nm/followers",
      "following_url": "https://api.github.com/users/a3nm/following{/other_user}",
