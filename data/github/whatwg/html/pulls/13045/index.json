  "title": "Don't hide popovers that moved document while hiding a popover stack",
  "user": {
    "login": "jakearchibald",
    "id": 93594,
    "node_id": "MDQ6VXNlcjkzNTk0",
    "avatar_url": "https://avatars.githubusercontent.com/u/93594?v=4",
    "gravatar_id": "",
