      "gists_url": "https://api.github.com/users/szewai/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/szewai/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/szewai/subscriptions",
      "organizations_url": "https://api.github.com/users/szewai/orgs",
      "repos_url": "https://api.github.com/users/szewai/repos",
      "events_url": "https://api.github.com/users/szewai/events{/privacy}",
