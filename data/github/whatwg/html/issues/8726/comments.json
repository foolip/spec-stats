    "created_at": "2023-01-13T15:41:09Z",
    "updated_at": "2023-01-13T15:41:09Z",
    "body": "A character encoding declaration is not required for conformant HTML. What is required is that *if* you include one, its contents be `utf-8`. But you don't have to include one.",
    "author_association": "MEMBER",
    "pin": null,
