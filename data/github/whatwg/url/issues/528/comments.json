  {
    "url": "https://api.github.com/repos/whatwg/url/issues/comments/676504833",
    "html_url": "https://github.com/whatwg/url/issues/528#issuecomment-676504833",
    "issue_url": "https://api.github.com/repos/whatwg/url/issues/528",
    "id": 676504833,
    "node_id": "MDEyOklzc3VlQ29tbWVudDY3NjUwNDgzMw==",
    "user": {
      "login": "sleevi",
      "id": 1487399,
      "node_id": "MDQ6VXNlcjE0ODczOTk=",
      "avatar_url": "https://avatars.githubusercontent.com/u/1487399?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/sleevi",
      "html_url": "https://github.com/sleevi",
      "followers_url": "https://api.github.com/users/sleevi/followers",
      "following_url": "https://api.github.com/users/sleevi/following{/other_user}",
      "gists_url": "https://api.github.com/users/sleevi/gists{/gist_id}",
