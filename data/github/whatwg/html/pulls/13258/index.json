  "title": "Support cross-realm WebAssembly.Module CSP checks through serialization",
  "user": {
    "login": "guybedford",
    "id": 598730,
    "node_id": "MDQ6VXNlcjU5ODczMA==",
    "avatar_url": "https://avatars.githubusercontent.com/u/598730?v=4",
