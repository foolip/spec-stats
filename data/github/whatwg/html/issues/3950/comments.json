    "url": "https://api.github.com/repos/whatwg/html/issues/comments/417102495",
    "html_url": "https://github.com/whatwg/html/issues/3950#issuecomment-417102495",
    "issue_url": "https://api.github.com/repos/whatwg/html/issues/3950",
    "id": 417102495,
    "node_id": "MDEyOklzc3VlQ29tbWVudDQxNzEwMjQ5NQ==",
    "user": {
      "login": "MatsPalmgren",
      "id": 4010828,
      "node_id": "MDQ6VXNlcjQwMTA4Mjg=",
      "avatar_url": "https://avatars.githubusercontent.com/u/4010828?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/MatsPalmgren",
      "html_url": "https://github.com/MatsPalmgren",
      "followers_url": "https://api.github.com/users/MatsPalmgren/followers",
      "following_url": "https://api.github.com/users/MatsPalmgren/following{/other_user}",
      "gists_url": "https://api.github.com/users/MatsPalmgren/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/MatsPalmgren/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/MatsPalmgren/subscriptions",
      "organizations_url": "https://api.github.com/users/MatsPalmgren/orgs",
      "repos_url": "https://api.github.com/users/MatsPalmgren/repos",
      "events_url": "https://api.github.com/users/MatsPalmgren/events{/privacy}",
      "received_events_url": "https://api.github.com/users/MatsPalmgren/received_events",
      "type": "User",
