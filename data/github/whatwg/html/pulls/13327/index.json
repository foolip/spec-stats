    "html_url": "https://github.com/sprrw",
    "followers_url": "https://api.github.com/users/sprrw/followers",
    "following_url": "https://api.github.com/users/sprrw/following{/other_user}",
    "gists_url": "https://api.github.com/users/sprrw/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/sprrw/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/sprrw/subscriptions",
    "organizations_url": "https://api.github.com/users/sprrw/orgs",
    "repos_url": "https://api.github.com/users/sprrw/repos",
    "events_url": "https://api.github.com/users/sprrw/events{/privacy}",
