      "following_url": "https://api.github.com/users/jan-ivar/following{/other_user}",
      "gists_url": "https://api.github.com/users/jan-ivar/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/jan-ivar/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/jan-ivar/subscriptions",
      "organizations_url": "https://api.github.com/users/jan-ivar/orgs",
      "repos_url": "https://api.github.com/users/jan-ivar/repos",
      "events_url": "https://api.github.com/users/jan-ivar/events{/privacy}",
      "received_events_url": "https://api.github.com/users/jan-ivar/received_events",
      "type": "User",
      "user_view_type": "public",
      "site_admin": false
