  "title": "Add WebDriver BiDi hooks for pageshow and pagehide",
  "user": {
    "login": "juliandescottes",
    "id": 1141550,
    "node_id": "MDQ6VXNlcjExNDE1NTA=",
    "avatar_url": "https://avatars.githubusercontent.com/u/1141550?v=4",
