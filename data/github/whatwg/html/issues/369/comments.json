    "url": "https://api.github.com/repos/whatwg/html/issues/comments/361430462",
    "html_url": "https://github.com/whatwg/html/issues/369#issuecomment-361430462",
    "issue_url": "https://api.github.com/repos/whatwg/html/issues/369",
    "id": 361430462,
    "node_id": "MDEyOklzc3VlQ29tbWVudDM2MTQzMDQ2Mg==",
    "user": {
      "login": "bzbarsky",
      "id": 1457979,
      "node_id": "MDQ6VXNlcjE0NTc5Nzk=",
      "avatar_url": "https://avatars.githubusercontent.com/u/1457979?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/bzbarsky",
      "html_url": "https://github.com/bzbarsky",
      "followers_url": "https://api.github.com/users/bzbarsky/followers",
      "following_url": "https://api.github.com/users/bzbarsky/following{/other_user}",
