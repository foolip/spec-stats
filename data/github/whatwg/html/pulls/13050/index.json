    "html_url": "https://github.com/noamr",
    "followers_url": "https://api.github.com/users/noamr/followers",
    "following_url": "https://api.github.com/users/noamr/following{/other_user}",
    "gists_url": "https://api.github.com/users/noamr/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/noamr/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/noamr/subscriptions",
    "organizations_url": "https://api.github.com/users/noamr/orgs",
    "repos_url": "https://api.github.com/users/noamr/repos",
