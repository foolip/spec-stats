    "issue_url": "https://api.github.com/repos/whatwg/usb/issues/127",
    "id": 421171925,
    "node_id": "MDEyOklzc3VlQ29tbWVudDQyMTE3MTkyNQ==",
    "user": {
      "login": "prusnak",
      "id": 42201,
      "node_id": "MDQ6VXNlcjQyMjAx",
