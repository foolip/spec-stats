  "locked": false,
  "title": "Fix corner case invoker issue with popover nested inside invoker",
  "user": {
    "login": "mfreed7",
    "id": 29559695,
    "node_id": "MDQ6VXNlcjI5NTU5Njk1",
    "avatar_url": "https://avatars.githubusercontent.com/u/29559695?v=4",
