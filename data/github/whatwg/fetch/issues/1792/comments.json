    "node_id": "IC_kwDOAFgnJc6WpphA",
    "user": {
      "login": "denis-migdal",
      "id": 16555663,
      "node_id": "MDQ6VXNlcjE2NTU1NjYz",
      "avatar_url": "https://avatars.githubusercontent.com/u/16555663?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/denis-migdal",
      "html_url": "https://github.com/denis-migdal",
      "followers_url": "https://api.github.com/users/denis-migdal/followers",
