  "title": "Let callers of clone a node exclude descendants",
  "user": {
    "login": "annevk",
    "id": 1544111,
    "node_id": "MDQ6VXNlcjE1NDQxMTE=",
    "avatar_url": "https://avatars.githubusercontent.com/u/1544111?v=4",
