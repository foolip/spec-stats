  "locked": false,
  "title": "Un-break build by making review-drafts/2023-07.wattsi use non-void <ref></ref>",
  "user": {
    "login": "sideshowbarker",
    "id": 194984,
    "node_id": "MDQ6VXNlcjE5NDk4NA==",
    "avatar_url": "https://avatars.githubusercontent.com/u/194984?v=4",
