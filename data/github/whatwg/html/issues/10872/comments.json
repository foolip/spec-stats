  {
    "url": "https://api.github.com/repos/whatwg/html/issues/comments/2575356081",
    "html_url": "https://github.com/whatwg/html/issues/10872#issuecomment-2575356081",
    "issue_url": "https://api.github.com/repos/whatwg/html/issues/10872",
    "id": 2575356081,
    "node_id": "IC_kwDOALaj486ZgNCx",
    "user": {
      "login": "ccameron-chromium",
      "id": 32557109,
      "node_id": "MDQ6VXNlcjMyNTU3MTA5",
      "avatar_url": "https://avatars.githubusercontent.com/u/32557109?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/ccameron-chromium",
      "html_url": "https://github.com/ccameron-chromium",
      "followers_url": "https://api.github.com/users/ccameron-chromium/followers",
      "following_url": "https://api.github.com/users/ccameron-chromium/following{/other_user}",
      "gists_url": "https://api.github.com/users/ccameron-chromium/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/ccameron-chromium/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/ccameron-chromium/subscriptions",
      "organizations_url": "https://api.github.com/users/ccameron-chromium/orgs",
      "repos_url": "https://api.github.com/users/ccameron-chromium/repos",
      "events_url": "https://api.github.com/users/ccameron-chromium/events{/privacy}",
      "received_events_url": "https://api.github.com/users/ccameron-chromium/received_events",
      "type": "User",
