  "body": "Create `readiness.window.js`:\r\n```js\r\nasync_test(t => {\r\n  const frame = document.body.appendChild(document.createElement(\"iframe\"));\r\n  frame.src = \"/common/blank.html\";\r\n  frame.onload = t.step_func(() => {\r\n    frame.contentDocument.onreadystatechange = t.unreached_func(\"readystatechange should not fire\");\r\n    assert_equals(frame.contentDocument.readyState, \"complete\");\r\n    frame.contentDocument.open();\r\n    assert_equals(frame.contentDocument.readyState, \"loading\");\r\n    frame.contentDocument.close();\r\n    assert_equals(frame.contentDocument.readyState, \"complete\");\r\n    t.step_timeout(() => t.done(), 500);\r\n  });\r\n}, \"document.open() and readiness\");\r\n```\r\nI was hoping this would be easy to fix, but especially that last assert, which isn't true for Firefox, would require a lot more research into \"stops parsing\".",
