  {
    "url": "https://api.github.com/repos/whatwg/html/issues/comments/3375319156",
    "html_url": "https://github.com/whatwg/html/issues/11724#issuecomment-3375319156",
    "issue_url": "https://api.github.com/repos/whatwg/html/issues/11724",
