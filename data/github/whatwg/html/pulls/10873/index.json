  "locked": false,
  "title": "Add a `lang` IDL Attribute to CanvasTextDrawingStyles, and clarify \"direction\" on same",
  "user": {
    "login": "schenney-chromium",
    "id": 7917425,
    "node_id": "MDQ6VXNlcjc5MTc0MjU=",
    "avatar_url": "https://avatars.githubusercontent.com/u/7917425?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/schenney-chromium",
    "html_url": "https://github.com/schenney-chromium",
    "followers_url": "https://api.github.com/users/schenney-chromium/followers",
    "following_url": "https://api.github.com/users/schenney-chromium/following{/other_user}",
    "gists_url": "https://api.github.com/users/schenney-chromium/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/schenney-chromium/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/schenney-chromium/subscriptions",
    "organizations_url": "https://api.github.com/users/schenney-chromium/orgs",
    "repos_url": "https://api.github.com/users/schenney-chromium/repos",
    "events_url": "https://api.github.com/users/schenney-chromium/events{/privacy}",
    "received_events_url": "https://api.github.com/users/schenney-chromium/received_events",
