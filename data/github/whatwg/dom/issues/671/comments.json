    "issue_url": "https://api.github.com/repos/whatwg/dom/issues/671",
    "id": 409185870,
    "node_id": "MDEyOklzc3VlQ29tbWVudDQwOTE4NTg3MA==",
    "user": {
      "login": "ghost",
      "id": 10137,
