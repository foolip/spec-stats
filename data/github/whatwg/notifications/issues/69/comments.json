    "issue_url": "https://api.github.com/repos/whatwg/notifications/issues/69",
    "id": 205324670,
    "node_id": "MDEyOklzc3VlQ29tbWVudDIwNTMyNDY3MA==",
    "user": {
      "login": "beverloo",
      "id": 418835,
      "node_id": "MDQ6VXNlcjQxODgzNQ==",
      "avatar_url": "https://avatars.githubusercontent.com/u/418835?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/beverloo",
      "html_url": "https://github.com/beverloo",
      "followers_url": "https://api.github.com/users/beverloo/followers",
      "following_url": "https://api.github.com/users/beverloo/following{/other_user}",
      "gists_url": "https://api.github.com/users/beverloo/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/beverloo/starred{/owner}{/repo}",
