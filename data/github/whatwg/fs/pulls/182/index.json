  "title": "fs: Remove nullable markers from WriteParams members",
  "user": {
    "login": "usamanadeemdeveloper",
    "id": 106808399,
    "node_id": "U_kgDOBl3ETw",
    "avatar_url": "https://avatars.githubusercontent.com/u/106808399?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/usamanadeemdeveloper",
    "html_url": "https://github.com/usamanadeemdeveloper",
