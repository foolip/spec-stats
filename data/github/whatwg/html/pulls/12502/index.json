  "title": "Rework resource selection algorithm to avoid interleaved jumps",
  "user": {
    "login": "nicolo-ribaudo",
    "id": 7000710,
    "node_id": "MDQ6VXNlcjcwMDA3MTA=",
    "avatar_url": "https://avatars.githubusercontent.com/u/7000710?v=4",
