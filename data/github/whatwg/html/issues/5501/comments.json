    "node_id": "IC_kwDOALaj488AAAABPCOLwQ",
    "user": {
      "login": "andrewmcguinness",
      "id": 1634354,
      "node_id": "MDQ6VXNlcjE2MzQzNTQ=",
      "avatar_url": "https://avatars.githubusercontent.com/u/1634354?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/andrewmcguinness",
      "html_url": "https://github.com/andrewmcguinness",
      "followers_url": "https://api.github.com/users/andrewmcguinness/followers",
      "following_url": "https://api.github.com/users/andrewmcguinness/following{/other_user}",
      "gists_url": "https://api.github.com/users/andrewmcguinness/gists{/gist_id}",
