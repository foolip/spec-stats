  "locked": false,
  "title": "Use module referrer policy for descendant fetches",
  "user": {
    "login": "domfarolino",
    "id": 9669289,
    "node_id": "MDQ6VXNlcjk2NjkyODk=",
    "avatar_url": "https://avatars.githubusercontent.com/u/9669289?v=4",
    "gravatar_id": "",
