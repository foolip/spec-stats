    "following_url": "https://api.github.com/users/mfreed7/following{/other_user}",
    "gists_url": "https://api.github.com/users/mfreed7/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/mfreed7/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/mfreed7/subscriptions",
    "organizations_url": "https://api.github.com/users/mfreed7/orgs",
    "repos_url": "https://api.github.com/users/mfreed7/repos",
    "events_url": "https://api.github.com/users/mfreed7/events{/privacy}",
    "received_events_url": "https://api.github.com/users/mfreed7/received_events",
