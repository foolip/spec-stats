    "created_at": "2016-09-26T23:19:19Z",
    "updated_at": "2016-09-26T23:19:19Z",
    "body": "transferToImageBitmap takes the OffscreenCanvas's internal storage and places it in a newly created ImageBitmap object. The intent is that it does not make a copy of the OffscreenCanvas's contents, but transfers them into an ImageBitmap -- thus the name.\n",
    "author_association": "MEMBER",
    "pin": null,
