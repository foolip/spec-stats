      "following_url": "https://api.github.com/users/tabatkins/following{/other_user}",
      "gists_url": "https://api.github.com/users/tabatkins/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/tabatkins/starred{/owner}{/repo}",
