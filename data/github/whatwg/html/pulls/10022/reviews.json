        "href": "https://api.github.com/repos/whatwg/html/pulls/10022"
      }
    },
    "submitted_at": "2024-01-24T16:59:44Z",
    "commit_id": "e397a92c92c1fa859b4d579cd07fe9e10e3e8ffe"
