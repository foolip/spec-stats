  "title": "Track current pixel density and EXIF dimensions per image request",
  "user": {
    "login": "noamr",
    "id": 88566,
    "node_id": "MDQ6VXNlcjg4NTY2",
    "avatar_url": "https://avatars.githubusercontent.com/u/88566?v=4",
    "gravatar_id": "",
