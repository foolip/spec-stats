  "locked": false,
  "title": "Fix user-agent style rules for top layer transitions",
  "user": {
    "login": "josepharhar",
    "id": 7681467,
    "node_id": "MDQ6VXNlcjc2ODE0Njc=",
    "avatar_url": "https://avatars.githubusercontent.com/u/7681467?v=4",
    "gravatar_id": "",
