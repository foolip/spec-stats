  "number": 12421,
  "state": "closed",
  "locked": false,
  "title": "Don't update active document too early for same-origin navigations",
  "user": {
    "login": "shannonbooth",
    "id": 35911232,
    "node_id": "MDQ6VXNlcjM1OTExMjMy",
    "avatar_url": "https://avatars.githubusercontent.com/u/35911232?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/shannonbooth",
    "html_url": "https://github.com/shannonbooth",
    "followers_url": "https://api.github.com/users/shannonbooth/followers",
    "following_url": "https://api.github.com/users/shannonbooth/following{/other_user}",
    "gists_url": "https://api.github.com/users/shannonbooth/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/shannonbooth/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/shannonbooth/subscriptions",
    "organizations_url": "https://api.github.com/users/shannonbooth/orgs",
    "repos_url": "https://api.github.com/users/shannonbooth/repos",
    "events_url": "https://api.github.com/users/shannonbooth/events{/privacy}",
    "received_events_url": "https://api.github.com/users/shannonbooth/received_events",
