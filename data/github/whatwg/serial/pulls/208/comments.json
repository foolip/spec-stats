      "gists_url": "https://api.github.com/users/chengweih001/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/chengweih001/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/chengweih001/subscriptions",
      "organizations_url": "https://api.github.com/users/chengweih001/orgs",
