      "following_url": "https://api.github.com/users/foolip/following{/other_user}",
      "gists_url": "https://api.github.com/users/foolip/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/foolip/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/foolip/subscriptions",
      "organizations_url": "https://api.github.com/users/foolip/orgs",
      "repos_url": "https://api.github.com/users/foolip/repos",
      "events_url": "https://api.github.com/users/foolip/events{/privacy}",
      "received_events_url": "https://api.github.com/users/foolip/received_events",
      "type": "User",
      "user_view_type": "public",
      "site_admin": false
    },
    "created_at": "2016-06-30T15:49:14Z",
    "updated_at": "2016-06-30T15:49:14Z",
    "body": "> The wording could probably be: when the fullscreen element is neither null nor the root element, the computed value of viewport's `overflow` property is ignored, and `hidden` is used instead.\n\nIs the viewport something that has style at all, or could this be the root element? If it's the root element, should this override show up in the computed style?\n",
    "author_association": "MEMBER",
    "pin": null,
    "reactions": {
      "url": "https://api.github.com/repos/whatwg/fullscreen/issues/comments/229701414/reactions",
      "total_count": 0,
      "+1": 0,
      "-1": 0,
